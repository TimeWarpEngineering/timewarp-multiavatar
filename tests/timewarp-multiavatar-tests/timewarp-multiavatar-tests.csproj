<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Jaribu on Microsoft Testing Platform; root global.json selects the MTP runner for dotnet test. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <RootNamespace>TimeWarp.Multiavatar.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TimeWarp.Jaribu.TestingPlatform" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceDirectory)timewarp-multiavatar/timewarp-multiavatar.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Upstream reference SVGs (see references/readme.md) are read from the output directory. -->
    <None Include="references/*.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
